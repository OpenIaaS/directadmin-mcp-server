# =============================================================================
# DirectAdmin MCP Server — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# Prefer a DirectAdmin LOGIN KEY over the main admin password.
# =============================================================================

# --- DirectAdmin connection (required) ---------------------------------------
# Must be https:// unless DA_ALLOW_INSECURE_HTTP=true
DA_URL=https://your-directadmin-server:2222
DA_USERNAME=admin
# Generate: Admin Level → Access Control / Login Keys
# Restrict the key to this MCP host IP and only the commands you need.
DA_LOGIN_KEY=replace-with-login-key

# Optional: impersonate a user on every request (admin|username style).
# Leave empty for native admin context. Per-tool impersonation is preferred.
DA_IMPERSONATE=

# Verify the DirectAdmin TLS certificate. Keep true in production.
DA_SSL_VERIFY=true

# Allow http:// DA_URL (lab only). Default false.
DA_ALLOW_INSECURE_HTTP=false

# Request timeout in seconds for DirectAdmin API calls.
DA_TIMEOUT=45

# --- MCP HTTP / SSE server ---------------------------------------------------
# Bind address. Use 127.0.0.1 if you put a reverse proxy in front.
MCP_HOST=127.0.0.1
PORT=8888
LOG_LEVEL=INFO
DEBUG=false
MCP_NAME=directadmin

# Transport: sse | streamable-http  (stdio is started via `python server.py`)
MCP_TRANSPORT=sse

# --- Authentication (HTTP mode) ----------------------------------------------
# REQUIRED in production. Clients send: Authorization: Bearer <token>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_AUTH_TOKEN=

# Dev-only. Allows unauthenticated HTTP access. Must stay false in production.
MCP_ALLOW_ANONYMOUS=false

# Comma-separated CORS origins. Empty = same-origin / no wildcard.
# Never use * in production.
MCP_CORS_ORIGINS=

# Optional CIDR allow-list for the HTTP listener (comma-separated).
# Example: 127.0.0.1/32,10.0.0.0/8
MCP_ALLOWED_CIDRS=

# Reject HTTP bodies larger than this (bytes).
MCP_MAX_BODY_BYTES=1048576

# --- Tool policy -------------------------------------------------------------
# Comma-separated tool name prefixes or exact names to allow. Empty = all.
# Example: ssl_,csf_,bfm_,firewall_,da_ping,da_list,da_describe,session_get
TOOL_ALLOWLIST=

# Comma-separated tool names/prefixes that are always blocked.
# csf_disable is denied by default — it turns the firewall off.
TOOL_DENYLIST=da_execute,csf_disable

# Require confirm=true on destructive tools (delete, deny, restart, …).
REQUIRE_CONFIRM=true

# Optional host-side phrase. When set, confirm=true is rejected — the
# operator must paste this token. Stops a rogue model that "just deletes".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
APPROVAL_TOKEN=

# --- Optional capabilities (ALL default false except CSF) --------------------
# A model will pass confirm=true without asking. Keep these off unless you
# need that family on this box. policy_status shows the live set.

# Allow the generic /api/execute passthrough (runs commands as the DA user).
ENABLE_EXECUTE=false

# Allow CSF plugin calls. Requires the ConfigServer CSF DirectAdmin plugin.
ENABLE_CSF=true

# Allow the csf_disable tool (csf -x). Keep false. Use csf_unblock_ip instead.
ENABLE_CSF_DISABLE=false

# CloudLinux LVE / CageFS / PHP Selector. Only on the 7–8 CL boxes.
ENABLE_CLOUDLINUX=false

# Irreversible / blast-radius families. Off = the agent cannot do them.
ENABLE_DELETE=false
ENABLE_ACCOUNT_WRITE=false
ENABLE_FILEMANAGER_WRITE=false
ENABLE_CUSTOMBUILD=false
ENABLE_OS_UPDATES=false
ENABLE_PLUGIN_WRITE=false
ENABLE_BACKUP_RESTORE=false
ENABLE_SERVICE_CONTROL=false
ENABLE_CONFIG_WRITE=false
ENABLE_DA_WRITE=false

# Rate limit (requests per minute) per client identity. 0 disables.
RATE_LIMIT_PER_MINUTE=60

# Audit log path (JSON lines). Secrets are redacted. Each tool call is one event.
AUDIT_LOG=logs/audit.jsonl

# Who is calling. HTTP can override per request with X-Agent-Id / X-MCP-Actor.
MCP_ACTOR=helpdesk-bot

# Optional maintenance window for mutating families (restart, updates, deletes).
# SSL reissue and CSF unblock stay 24/7. Empty = no time gate.
# MAINTENANCE_WINDOW=Mon-Fri 01:00-05:00 Europe/Sofia
MAINTENANCE_WINDOW=
WINDOW_ENFORCE=true
